### =========================
### REVIEW
### =========================

### Get all reviews
GET http://localhost:8080/reviews

### Get one review
GET http://localhost:8080/reviews/1

### Create review
POST http://localhost:8080/reviews
Content-Type: application/json

{
  "text": "Amazing book!",
  "dateCreated": "2026-08-21",
  "rating": 5
}

### Update review
PUT http://localhost:8080/reviews/1
Content-Type: application/json

{
  "text": "Really amazing book!",
  "dateCreated": "2026-08-21",
  "rating": 4
}

### Delete review
DELETE http://localhost:8080/reviews/1



### =========================
### LIBRARY ENTRY
### =========================

### Get all library entries
GET http://localhost:8080/library-entries

### Get one library entry
GET http://localhost:8080/library-entries/1

### Create library entry
POST http://localhost:8080/library-entries
Content-Type: application/json

{
  "dateAdded": "2026-08-21",
  "format": "PAPERBACK",
  "title": "The Hobbit",
  "description": "A fantasy novel",
  "image": "hobbit.jpg",
  "rating": 5
}

### Update library entry
PUT http://localhost:8080/library-entries/1
Content-Type: application/json

{
  "dateAdded": "2026-08-21",
  "format": "EBOOK",
  "title": "The Hobbit Updated",
  "description": "Updated description",
  "image": "new-image.jpg",
  "rating": 4
}

### Delete library entry
DELETE http://localhost:8080/library-entries/1



### =========================
### GROUP
### =========================

### Get all groups
GET http://localhost:8080/groups
###
GET http://localhost:8080/groups/2/members

### Get one group
GET http://localhost:8080/groups/2

### Create group
POST http://localhost:8080/groups
Content-Type: application/json

{
  "name": "GrB",
  "description": "People who love biography books"
}

### Update group
PUT http://localhost:8080/groups/1
Content-Type: application/json

{
  "id": 1,
  "name": "Fantasy Book Club",
  "description": "Our fantasy book club"
}

### Delete group
DELETE http://localhost:8080/groups/10


### =========================
### GROUP ↔ USER
### =========================


###
GET http://localhost:8080/groups

### add user from specific group ✅
POST http://localhost:8080/users/groups/2/user/3

### add to collection ✅
POST http://localhost:8080/users/2/collection
Content-Type: application/json

{
  "name": "Read"
}

### add author from specific work ✅
POST http://localhost:8080/works/2/2

### write review ✅
POST http://localhost:8080/users/2/work/2/reviews
Content-Type: application/json

{
  "text": "it is such a great book",
  "rating": 4.5
}

### add libraryEntry ✅ except col and tag
POST http://localhost:8080/users/2/library-entry/work/2
Content-Type: application/json

{
  "rating" : 4.2,
  "format" : "HARDCOVER",
  "image" : "lel.png",
  "title" : "le1"
}


